---
// La portada: etiqueta, titular, buscador grande y accesos rápidos a la izquierda, y a la derecha la
// cadena animada sobre un lienzo de puntos (como el lienzo de Luvin). Reemplaza al Hero de Starlight.
// El texto sale del `hero` de cada index.mdx; las `actions` son los accesos rápidos.
import ChainArt from './ChainArt.astro'

// El id que Starlight da al título de la página (lo usa el índice "En esta página").
const PAGE_TITLE_ID = '_top'
const { entry, lang } = Astro.locals.starlightRoute
const hero = entry.data.hero!
const es = lang === 'es'
const searchLabel = es ? 'Busca en la documentación' : 'Search the documentation'
---

<div class="docs-hero">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="hero-text">
    <p class="eyebrow">
      <span class="dot" aria-hidden="true"></span>
      {entry.data.title}
      <span class="sep" aria-hidden="true">·</span>
      <span class="ver">v0.1</span>
    </p>
    <h1 id={PAGE_TITLE_ID} data-page-title set:html={hero.title ?? entry.data.title} />
    {hero.tagline && <p class="tagline" set:html={hero.tagline} />}
    <button class="hero-search" type="button" data-hero-search aria-label={searchLabel}>
      <svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
      <span class="ph">{searchLabel}</span>
      <span class="keys"><kbd>⌘</kbd><kbd>K</kbd></span>
    </button>
    {
      hero.actions.length > 0 && (
        <nav class="hero-links" aria-label={es ? 'Accesos rápidos' : 'Quick links'}>
          {hero.actions.map((a) => (
            <a href={a.link}>
              {a.text}
              <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14 M13 6l6 6-6 6" /></svg>
            </a>
          ))}
        </nav>
      )
    }
  </div>
  <div class="hero-art">
    <div class="canvas">
      <div class="canvas-bar" aria-hidden="true">
        <span></span><span></span><span></span>
        <em>{es ? 'Ejecutando · API real' : 'Running · Real API'}</em>
      </div>
      <ChainArt es={es} />
    </div>
  </div>
</div>

<script>
  // El buscador grande abre el mismo buscador de la cabecera (sus atajos ⌘K y "/" los maneja él).
  // El buscador de Starlight se cierra con cualquier clic fuera de él: el clic que lo abre desde aquí no
  // debe seguir subiendo por la página, o lo cerraría en el mismo instante.
  const open = () => document.querySelector<HTMLButtonElement>('lv-search [data-open-modal]')?.click()
  document.querySelector('[data-hero-search]')?.addEventListener('click', (e) => {
    e.preventDefault()
    e.stopPropagation()
    open()
  })
</script>

<style>
  .docs-hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 3.5rem;
    margin: -1.5rem 0 1rem;
    padding: 4.5rem 0 4rem;
  }
  /* El fondo de lado a lado: la cuadrícula de puntos del lienzo de Luvin, que se desvanece hacia los
     bordes, y un brillo verde detrás de la cadena. */
  .hero-bg {
    position: absolute;
    inset: 0 calc(50% - 50vw);
    z-index: -1;
    background:
      radial-gradient(38rem 26rem at 78% 45%, color-mix(in srgb, var(--sl-color-accent) 22%, transparent), transparent 70%),
      radial-gradient(30rem 20rem at 15% 0%, color-mix(in srgb, var(--sl-color-accent) 10%, transparent), transparent 70%),
      radial-gradient(circle, var(--docs-dot) 1.1px, transparent 1.4px) 0 0 / 22px 22px;
    mask-image: radial-gradient(ellipse 85% 100% at 50% 30%, #000 45%, transparent 100%);
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.8rem 0.3rem 0.65rem;
    border: 1px solid color-mix(in srgb, var(--sl-color-accent) 40%, var(--sl-color-gray-5));
    border-radius: 999px;
    background: color-mix(in srgb, var(--sl-color-accent) 10%, var(--sl-color-black));
    font-size: var(--sl-text-xs);
    font-weight: 600;
    color: var(--sl-color-text-accent);
  }
  .eyebrow .dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--sl-color-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--sl-color-accent) 30%, transparent);
  }
  .eyebrow .sep,
  .eyebrow .ver {
    color: var(--sl-color-gray-3);
    font-weight: 500;
  }
  h1 {
    margin-top: 1.25rem;
    max-width: 36rem;
    font-size: clamp(2.4rem, 5vw, 3.7rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.02;
    color: var(--sl-color-white);
  }
  h1 :global(em) {
    font-style: normal;
    background: linear-gradient(100deg, var(--sl-color-accent) 0%, var(--docs-accent-2) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .tagline {
    margin-top: 1.1rem;
    max-width: 34rem;
    font-size: 1.15rem;
    line-height: 1.55;
    color: var(--sl-color-gray-2);
  }
  .hero-search {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    max-width: 34rem;
    margin-top: 2rem;
    padding: 0.95rem 0.95rem 0.95rem 1.15rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.9rem;
    background: color-mix(in srgb, var(--sl-color-black) 82%, transparent);
    backdrop-filter: blur(8px);
    color: var(--sl-color-gray-3);
    font: inherit;
    font-size: var(--sl-text-base);
    text-align: start;
    cursor: pointer;
    box-shadow:
      0 1px 0 color-mix(in srgb, #fff 5%, transparent) inset,
      0 12px 32px -12px rgba(0, 0, 0, 0.35);
    transition:
      border-color 0.15s,
      box-shadow 0.15s;
  }
  .hero-search:hover,
  .hero-search:focus-visible {
    border-color: var(--sl-color-accent);
    box-shadow:
      0 0 0 4px color-mix(in srgb, var(--sl-color-accent) 18%, transparent),
      0 12px 32px -12px rgba(0, 0, 0, 0.35);
    color: var(--sl-color-gray-2);
  }
  .hero-search .ph {
    flex: 1;
  }
  .keys {
    display: flex;
    gap: 0.25rem;
  }
  .keys kbd {
    display: grid;
    place-items: center;
    min-width: 1.6rem;
    height: 1.6rem;
    padding: 0 0.35rem;
    border: 1px solid var(--sl-color-gray-5);
    border-bottom-width: 2px;
    border-radius: 0.4rem;
    background: var(--sl-color-gray-6);
    font-family: inherit;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-2);
  }
  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    max-width: 36rem;
    margin-top: 1.4rem;
  }
  .hero-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.42rem 0.85rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    background: color-mix(in srgb, var(--sl-color-black) 70%, transparent);
    font-size: var(--sl-text-sm);
    font-weight: 500;
    color: var(--sl-color-gray-1);
    text-decoration: none;
    transition:
      border-color 0.15s,
      background 0.15s,
      color 0.15s;
  }
  .hero-links a svg {
    color: var(--sl-color-text-accent);
    transition: transform 0.15s;
  }
  .hero-links a:hover {
    border-color: var(--sl-color-accent);
    background: color-mix(in srgb, var(--sl-color-accent) 12%, var(--sl-color-black));
    color: var(--sl-color-white);
  }
  .hero-links a:hover svg {
    transform: translateX(2px);
  }
  /* La cadena, dentro de una ventana como el lienzo de la app. */
  .hero-art {
    width: 27rem;
  }
  .canvas {
    position: relative;
    padding: 1.1rem 1.6rem 1.9rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 1.1rem;
    background:
      radial-gradient(circle, var(--docs-dot) 1px, transparent 1.3px) 0 0 / 18px 18px,
      color-mix(in srgb, var(--sl-color-black) 88%, transparent);
    box-shadow:
      0 1px 0 color-mix(in srgb, #fff 6%, transparent) inset,
      0 30px 70px -25px color-mix(in srgb, var(--sl-color-accent) 45%, rgba(0, 0, 0, 0.5));
    backdrop-filter: blur(6px);
  }
  .canvas-bar {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0 -0.5rem 1.4rem;
  }
  .canvas-bar span {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--sl-color-gray-5);
  }
  .canvas-bar em {
    margin-left: auto;
    font-style: normal;
    font-size: var(--sl-text-xs);
    font-weight: 600;
    color: var(--sl-color-text-accent);
  }
  .canvas-bar em::before {
    content: '';
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    margin-right: 0.4rem;
    border-radius: 50%;
    background: var(--sl-color-accent);
    animation: hero-blink 1.6s ease-in-out infinite;
  }
  @keyframes hero-blink {
    50% {
      opacity: 0.25;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .canvas-bar em::before {
      animation: none;
    }
  }
  @media (max-width: 64rem) {
    .docs-hero {
      grid-template-columns: 1fr;
      padding: 3rem 0 2.5rem;
    }
    .hero-art {
      display: none;
    }
  }
</style>
